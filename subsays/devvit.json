{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "sub-says",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "menu": {
    "items": [
      {
        "label": "Sub Says: start a new round now",
        "description": "Posts the next question (rounds also start by themselves every day)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-round"
      },
      {
        "label": "Sub Says: hide an answer",
        "description": "Remove an answer from the running rounds",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/hide"
      },
      {
        "label": "Sub Says: reset everything (testing)",
        "description": "Start again from zero with a fresh first round",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset"
      }
    ]
  },
  "forms": {
    "hideForm": "/internal/form/hide",
    "resetForm": "/internal/form/reset"
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily": {
        "endpoint": "/internal/cron/daily",
        "cron": "0 15 * * *"
      },
      "weekly-recap": {
        "endpoint": "/internal/cron/weekly-recap",
        "cron": "5 0 * * 1"
      }
    }
  },
  "settings": {
    "subreddit": {
      "autoPost": {
        "type": "boolean",
        "label": "Post a new round automatically",
        "helpText": "A new question is posted at 15:00 UTC whenever a round is due.",
        "defaultValue": true
      },
      "category": {
        "type": "select",
        "label": "Question category",
        "helpText": "Built-in questions fit this topic. Your own questions below always come first.",
        "options": [
          {
            "label": "General",
            "value": "general"
          },
          {
            "label": "Food",
            "value": "food"
          },
          {
            "label": "Gaming",
            "value": "gaming"
          },
          {
            "label": "Movies and TV",
            "value": "movies"
          },
          {
            "label": "Music",
            "value": "music"
          },
          {
            "label": "Sports",
            "value": "sports"
          },
          {
            "label": "Travel",
            "value": "travel"
          },
          {
            "label": "Tech",
            "value": "tech"
          },
          {
            "label": "Crypto",
            "value": "crypto"
          },
          {
            "label": "Fitness",
            "value": "fitness"
          },
          {
            "label": "Pets",
            "value": "pets"
          },
          {
            "label": "Memes",
            "value": "memes"
          }
        ],
        "defaultValue": "general"
      },
      "customQuestions": {
        "type": "paragraph",
        "label": "Your own questions (optional)",
        "helpText": "One per line, used before the built-in ones. Start each with 'Name ...' so people can answer in a word or two."
      },
      "roundMinutes": {
        "type": "select",
        "label": "Round length",
        "helpText": "How long people can answer, and then guess. Small subs do better with 48 or 72 hours. The two short options are for testing only.",
        "options": [
          {
            "label": "24 hours (a new question every day)",
            "value": "1440"
          },
          {
            "label": "48 hours",
            "value": "2880"
          },
          {
            "label": "72 hours",
            "value": "4320"
          },
          {
            "label": "1 hour (testing only)",
            "value": "60"
          },
          {
            "label": "10 minutes (testing only)",
            "value": "10"
          }
        ],
        "defaultValue": "1440"
      },
      "minPlayers": {
        "type": "number",
        "label": "People needed to make a board",
        "helpText": "If fewer people answer, the round is skipped.",
        "defaultValue": 20
      },
      "boardSize": {
        "type": "select",
        "label": "Board size",
        "helpText": "Auto uses 5 answers, and 8 once 200 people have answered.",
        "options": [
          {
            "label": "Auto",
            "value": "auto"
          },
          {
            "label": "5 answers",
            "value": "5"
          },
          {
            "label": "8 answers",
            "value": "8"
          }
        ],
        "defaultValue": "auto"
      },
      "theme": {
        "type": "select",
        "label": "Theme",
        "options": [
          {
            "label": "Classic",
            "value": "classic"
          },
          {
            "label": "Pepe frogs",
            "value": "pepe"
          }
        ],
        "defaultValue": "classic"
      },
      "sponsorNote": {
        "type": "string",
        "label": "Footer note (optional)",
        "helpText": "One line under the game, plain text, 280 characters."
      },
      "crowdBonus": {
        "type": "select",
        "label": "Crowd bonus",
        "helpText": "Off: points come from answering (20) and from guessing. Half: each of your answers that reaches the board also earns half its percentage. It rewards saying what most people say, so it is off by default.",
        "options": [
          {
            "label": "Off",
            "value": "off"
          },
          {
            "label": "Half of the percentage",
            "value": "half"
          }
        ],
        "defaultValue": "off"
      },
      "testMode": {
        "type": "boolean",
        "label": "Testing mode (turn off for real use)",
        "helpText": "Lets you answer and guess again and again, and lets one answer reach the board. Also lifts the limit on starting new rounds from the mod menu.",
        "defaultValue": false
      }
    }
  },
  "scripts": {
    "dev": "npm run build",
    "build": "npm run build"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  }
}
