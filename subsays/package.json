{
  "name": "sub-says",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Armada: a whole subreddit vs. one hidden fleet. Reddit Devvit Web app.",
  "scripts": {
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server/index.cjs",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "esbuild test/text.test.ts test/rounds.test.ts --bundle --platform=node --format=esm --outdir=dist/test --out-extension:.js=.mjs && node --test dist/test/*.mjs",
    "login": "devvit login",
    "playtest": "devvit playtest",
    "upload": "devvit upload",
    "local": "npm run build:client && esbuild tools/local.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/local.mjs && node dist/local.mjs"
  },
  "dependencies": {
    "@devvit/web": "0.14.8",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "devvit": "0.14.8",
    "esbuild": "0.25.0",
    "typescript": "5.8.3",
    "vite": "6.2.0"
  }
}
