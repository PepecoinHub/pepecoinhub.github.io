+import {validateAddress} from '../wallet-core.js';
+import {HUB_ORIGIN} from '../haze-auth-protocol.js';
+const UUID=/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
+const integer=x=>typeof x==='string'&&/^[1-9][0-9]{0,13}$/.test(x);
+const exact=(x,keys)=>x&&typeof x==='object'&&!Array.isArray(x)&&Object.keys(x).length===keys.length&&keys.every(key=>Object.hasOwn(x,key));
+const label=(x,n)=>typeof x==='string'&&x.length<=n&&!/[\u0000-\u001f\u007f\u202a-\u202e\u2066-\u2069]/u.test(x);
+export async function readGroupTip(raw){
+  if(!exact(raw,['id','sender','title','mode','note','total_atomic','created_at','expires_at','recipients'])||!UUID.test(raw.id)||!label(raw.title,120)||!label(raw.note,160)||!['all','online','offline','random','selected','airdrop','trivia','word'].includes(raw.mode)||!integer(raw.total_atomic)||BigInt(raw.total_atomic)>10000000000000n||!Array.isArray(raw.recipients)||raw.recipients.length<1||raw.recipients.length>200||!await validateAddress(raw.sender,'PEP'))throw Error('Invalid group review. Start again in PepecoinHub.');
+  const expiry=Date.parse(raw.expires_at),created=Date.parse(raw.created_at);
+  if(!Number.isFinite(created)||created>Date.now()+30000||!Number.isFinite(expiry)||new Date(expiry).toISOString()!==raw.expires_at||expiry<=Date.now()||expiry>Date.now()+1860000)throw Error('This group review expired.');
+  const seen=new Set(),recipients=[];let total=0n;
+  for(const item of raw.recipients){
+    if(!exact(item,['address','amount','nick'])||!label(item.nick,60)||!integer(item.amount)||BigInt(item.amount)<100000000n||seen.has(item.address)||item.address===raw.sender||!/^P[1-9A-HJ-NP-Za-km-z]{33}$/.test(item.address)||!await validateAddress(item.address,'PEP'))throw Error('Invalid or repeated group recipient.');
+    seen.add(item.address);total+=BigInt(item.amount);recipients.push(Object.freeze({...item}));
+  }
+  if(total.toString()!==raw.total_atomic)throw Error('The group split does not match its total.');
+  return Object.freeze({...raw,recipients:Object.freeze(recipients)});
+}
+export function notifyGroupSubmission(request,built,frame=globalThis.window){
+  const target=frame?.opener||(frame?.parent&&frame.parent!==frame?frame.parent:null);
+  if(!target||!UUID.test(request?.id||'')||!/^[a-f0-9]{64}$/.test(built?.txid||'')||built.amount!==request.total_atomic)return false;
+  const outputs=built.outputs?.filter(out=>!out.change);
+  if(!outputs||outputs.length!==request.recipients.length||outputs.some((out,n)=>out.address!==request.recipients[n].address||out.amount!==request.recipients[n].amount))return false;
+  target.postMessage({type:'haze:tip-submitted',version:1,intent:request.id,txid:built.txid},HUB_ORIGIN);return true;
+}
